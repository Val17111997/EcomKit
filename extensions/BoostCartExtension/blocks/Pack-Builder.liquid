{% if block.settings.pack_product %}
  {% assign product = all_products[block.settings.pack_product] %}
  {% if product and product.variants.size > 0 %}
    {% assign pack_size = block.settings.pack_size | default: 3 | plus: 0 | at_least: 1 %}

    <div id="bundle-toast-container" class="bundle-toast-container"></div>
    <div id="bundle-form" class="bundle-form">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      <div class="bundle-options">
        <h2 class="bundle-title">{{ block.settings.bundle_heading }}</h2>

        {% for i in (1..pack_size) %}
          <div class="bundle-slot" data-slot="{{ i }}">
            <div class="bundle-slot-header">
              <label for="slot-{{ i }}">{{ block.settings.variant_title }} {{ i }}</label>
              <div class="bundle-slot-status"><span class="bundle-checkmark">✓</span></div>
            </div>
            <div class="bundle-buttons" data-slot-index="{{ i }}">
              {% for variant in product.variants %}
                <button type="button" class="bundle-option-button" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
              {% endfor %}
              <input type="hidden" name="variant_{{ i }}" class="bundle-hidden-input" value="">
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded',function(){
      const packVariantId={{ product.variants.first.id }};
      const variantTitle="{{ block.settings.variant_title | escape }}";
      const validationMessage="{{ block.settings.validation_message | escape }}";
      const packSize={{ pack_size }};

      const $=(s,c=document)=>c.querySelector(s);
      const $$=(s,c=document)=>c.querySelectorAll(s);

      function showToast(msg,type='info'){
        const c=$('#bundle-toast-container'); const t=document.createElement('div');
        t.className=`bundle-toast bundle-toast-${type}`;
        t.innerHTML=`<span class="toast-message">${msg}</span><button class="toast-close">&times;</button>`;
        c.appendChild(t); setTimeout(()=>t.classList.add('show'),100);
        setTimeout(()=>removeToast(t),4000);
        t.querySelector('.toast-close').addEventListener('click',()=>removeToast(t));
      }
      function removeToast(t){ t.classList.remove('show'); setTimeout(()=>t.remove(),300); }

      function updateSlotStatus(slot,isSelected){
        slot.classList.toggle('bundle-slot-completed',isSelected);
        slot.classList.toggle('bundle-slot-empty',!isSelected);
      }
      function setButtonLoading(button,loading){
        if(loading){
          button.classList.add('loading');
          button.setAttribute('data-original-text',button.textContent);
          button.innerHTML='<span class="spinner"></span> Ajout en cours...';
          button.disabled=true;
        }else{
          button.classList.remove('loading');
          button.textContent=button.getAttribute('data-original-text')||'Ajouter au panier';
          button.disabled=false;
        }
      }

      const drawerTriggers=['[data-action="toggle-cart-drawer"]','[aria-controls="CartDrawer"]','[data-cart-toggle]','.header__icon--cart'];
      function openCartDrawer(){
        const drawerEl=document.querySelector('cart-drawer');
        if(drawerEl&&typeof drawerEl.open==='function'){
          const cd=document.querySelector('#my-cart-drawer,[role="dialog"][aria-label*="anier"],cart-drawer'); if(cd) cd.removeAttribute('aria-hidden');
          return drawerEl.open();
        }
        for(const sel of drawerTriggers){
          const btn=document.querySelector(sel);
          if(btn){ const cd=document.querySelector('#my-cart-drawer,[role="dialog"][aria-label*="anier"],cart-drawer'); if(cd) cd.removeAttribute('aria-hidden'); btn.click(); return; }
        }
      }

      // Sélection (doublons autorisés : pas de désactivation cross-slots)
      $$('.bundle-option-button').forEach(btn=>{
        btn.addEventListener('click',()=>{
          const wrap=btn.closest('.bundle-buttons');
          const hidden=wrap.querySelector('.bundle-hidden-input');
          const slot=btn.closest('.bundle-slot');
          wrap.querySelectorAll('.bundle-option-button').forEach(b=>b.classList.remove('active'));
          btn.classList.add('selecting');
          setTimeout(()=>{
            btn.classList.remove('selecting'); btn.classList.add('active');
            hidden.value=btn.dataset.variantId; updateSlotStatus(slot,true);
            setTimeout(checkAllSelectionsAndUpdateButton,50);
          },150);
        });
      });

      function checkAllSelectionsAndUpdateButton(){
        const form=$('#bundle-form'); let selected=0;
        form.querySelectorAll('.bundle-hidden-input').forEach(i=>{ if(i.value&&i.value.trim()!=='') selected++; });
        const allSelected=(selected>=packSize); const remaining=Math.max(0,packSize-selected);
        const nativeButtons=document.querySelectorAll('form[action*="/cart/add"] button[type="submit"], form[action*="/cart/add"] button[name="add"], .product-form__submit, button.product-form__cart-submit');
        nativeButtons.forEach(btn=>{
          btn.textContent=allSelected?'Ajouter au panier':`Sélectionnez ${remaining} option${remaining>1?'s':''} de plus`;
          btn.disabled=!allSelected;
        });
      }

      function createBundlePack(){
        const form=$('#bundle-form'); const props={}; let ok=true;
        form.querySelectorAll('.bundle-buttons').forEach((wrap,idx)=>{
          const hidden=wrap.querySelector('.bundle-hidden-input');
          if(!hidden.value){
            const slotNumber=idx+1; showToast(`${variantTitle} ${slotNumber} : ${validationMessage}`,'error');
            const slot=wrap.closest('.bundle-slot'); slot.classList.add('bundle-slot-error'); setTimeout(()=>slot.classList.remove('bundle-slot-error'),2000);
            ok=false; return false;
          }
          const active=wrap.querySelector('.bundle-option-button.active');
          if(active){ const text=active.textContent.trim(); props[`${variantTitle} ${idx+1}`]=text; props[`variant_id_${idx+1}`]=active.dataset.variantId; }
        });
        if(!ok) return false;

        const nativeButtons=document.querySelectorAll('form[action*="/cart/add"] button[type="submit"], form[action*="/cart/add"] button[name="add"], .product-form__submit, button.product-form__cart-submit');
        nativeButtons.forEach(b=>setButtonLoading(b,true));

        fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:packVariantId,quantity:1,properties:props})})
        .then(r=>typeof r.json==='function'?r.json():r)
        .then(()=>{
          showToast('✓ Pack ajouté au panier avec succès !','success');
          form.classList.add('bundle-success'); setTimeout(()=>form.classList.remove('bundle-success'),1000);
          setTimeout(openCartDrawer,500);
        })
        .catch(err=>{ console.error('Erreur complète:',err); showToast(`Erreur lors de l'ajout : ${err.message||err}`,'error'); })
        .finally(()=>{ nativeButtons.forEach(b=>setButtonLoading(b,false)); });

        return false;
      }

      setTimeout(()=>{
        const forms=document.querySelectorAll('form[action="/cart/add"], form[action*="/cart/add"], product-form form');
        const form=$('#bundle-form');
        forms.forEach(f=>{
          if(!form) return;
          f.addEventListener('submit',e=>{ e.preventDefault(); e.stopPropagation(); createBundlePack(); });
          f.querySelectorAll('button[type="submit"], input[type="submit"], button[name="add"]').forEach(btn=>{
            const copy=btn.cloneNode(true); btn.parentNode.replaceChild(copy,btn);
            copy.addEventListener('click',e=>{ e.preventDefault(); e.stopPropagation(); createBundlePack(); });
          });
        });

        document.addEventListener('product:add-to-cart',e=>{ if(form){ e.preventDefault(); e.stopImmediatePropagation(); createBundlePack(); }},true);
        document.addEventListener('cart:add',e=>{ if(form){ e.preventDefault(); e.stopImmediatePropagation(); createBundlePack(); }},true);
        checkAllSelectionsAndUpdateButton();
      },400);
    });
    </script>

    <style>
      .bundle-form{padding:1.5rem;border-radius:8px;background:#fafafa;transition:all .3s}
      .bundle-form.bundle-success{background:#f0f9f0;box-shadow:0 0 20px rgba(76,175,80,.3)}
      .bundle-title{margin-bottom:1rem;font-size:{{ block.settings.title_font_size | default: 24 }}px;font-weight:700;color:#333}
      .bundle-slot{margin-bottom:1.5rem;padding:1rem;border:2px solid #e0e0e0;border-radius:8px;background:#fff;transition:all .3s}
      .bundle-slot-empty{border-color:#ffeb3b;background:#fffef0}
      .bundle-slot-completed{border-color:#4CAF50;background:#f8fff8}
      .bundle-slot-error{border-color:#f44336;background:#fff5f5;animation:shake .5s}
      @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
      .bundle-slot-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem}
      .bundle-slot-header label{font-weight:600;font-size:{{ block.settings.label_font_size | default: 14 }}px;color:#333;margin:0}
      .bundle-slot-status{opacity:0;transition:opacity .3s}
      .bundle-slot-completed .bundle-slot-status{opacity:1}
      .bundle-checkmark{color:#4CAF50;font-weight:700;font-size:1.2rem}
      .bundle-buttons{display:flex;flex-wrap:wrap;gap:.75rem}
      .bundle-option-button{padding:.75rem 1.25rem;border:2px solid #ddd;border-radius:6px;background:#fff;cursor:pointer;font-size:{{ block.settings.button_font_size | default: 15 }}px;transition:all .2s;position:relative;overflow:hidden}
      .bundle-option-button:hover{border-color:#999;box-shadow:0 2px 8px rgba(0,0,0,.1);transform:translateY(-1px)}
      .bundle-option-button.selecting{transform:scale(.95)}
      .bundle-option-button.active{background:#333;color:#fff;border-color:#333;box-shadow:0 4px 12px rgba(0,0,0,.2)}
      .bundle-option-button.active::after{content:'✓';position:absolute;top:-2px;right:-2px;background:#4CAF50;color:#fff;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700}
      .loading{pointer-events:none;opacity:.7}
      .spinner{display:inline-block;width:16px;height:16px;border:2px solid #f3f3f3;border-top:2px solid #333;border-radius:50%;animation:spin 1s linear infinite;margin-right:8px}
      @keyframes spin{0%{transform:rotate(0)}100%{transform:rotate(360deg)}}
      .bundle-toast-container{position:fixed;top:20px;right:20px;z-index:10000}
      .bundle-toast{background:#fff;border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,.15);margin-bottom:10px;padding:1rem 1.5rem;display:flex;align-items:center;justify-content:space-between;max-width:350px;transform:translateX(100%);opacity:0;transition:all .3s}
      .bundle-toast.show{transform:translateX(0);opacity:1}
      .bundle-toast-success{border-left:4px solid #4CAF50}
      .bundle-toast-error{border-left:4px solid #f44336}
      .bundle-toast-info{border-left:4px solid #2196F3}
      .toast-close{background:none;border:none;font-size:1.5rem;cursor:pointer;padding:0;margin-left:1rem;opacity:.5}
      .toast-close:hover{opacity:1}
      @media (max-width:768px){
        .bundle-form{padding:1rem}
        .bundle-buttons{gap:.5rem}
        .bundle-option-button{padding:.5rem 1rem;font-size:14px}
        .bundle-toast-container{top:10px;right:10px;left:10px}
        .bundle-toast{max-width:none}
      }
      .bundle-error{color:#f44336;font-weight:700;padding:1rem;background:#fff5f5;border-radius:8px;border-left:4px solid #f44336}
    </style>
  {% else %}
    <p class="bundle-error">{% if product %}Le produit sélectionné n'a pas de variantes disponibles.{% else %}Le produit sélectionné n'existe pas ou n'est pas disponible.{% endif %}</p>
  {% endif %}
{% else %}
  <p class="bundle-error">Veuillez sélectionner un produit "Pack découverte" dans les réglages !</p>
{% endif %}

{% schema %}
{
  "name":"Pack-Builder",
  "target":"section",
  "settings":[
    { "type":"product","id":"pack_product","label":"Produit principal (pack découverte)","info":"Sélectionnez le produit (les variantes s’affichent). Le nombre de cases dépend du réglage « Taille du pack »." },
    { "type":"range","id":"pack_size","label":"Taille du pack (nombre d’articles à sélectionner)","min":1,"max":12,"step":1,"default":3 },
    { "type":"text","id":"bundle_heading","label":"Titre du pack (Heading)","default":"Composez votre pack :" },
    { "type":"text","id":"variant_title","label":"Titre de la variante","default":"Produit","info":"Titre affiché pour chaque sélection (ex: Produit, Complément, Supplément...)" },
    { "type":"text","id":"validation_message","label":"Message validation absence variant","default":"Veuillez sélectionner une variante" },
    { "type":"header","content":"Tailles de police" },
    { "type":"range","id":"title_font_size","label":"Taille du titre principal","min":12,"max":48,"step":1,"unit":"px","default":24 },
    { "type":"range","id":"label_font_size","label":"Taille des sous-titres (Produit 1, 2, etc.)","min":10,"max":20,"step":1,"unit":"px","default":14 },
    { "type":"range","id":"button_font_size","label":"Taille des boutons de variantes","min":10,"max":20,"step":1,"unit":"px","default":15 }
  ]
}
{% endschema %}
