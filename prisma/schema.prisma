generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model UsageSubscription {
  id              Int       @id @default(autoincrement())
  shop            String
  subscriptionId  String    @unique
  lineItemId      String
  status          String    @default("PENDING")
  orderCount      Int       @default(0)
  cycleStart      DateTime?           // <- optionnel
  confirmationUrl String?
  trialConsumed    Boolean   @default(false)

  @@index([shop])
}

model usageBillingState {
  id               Int       @id @default(autoincrement())
  shop             String
  periodKey        String
  billedTier       Int       @default(0)
  billedAmount     Float     @default(0)
  lastIdemKey      String?

  // 🔽 AJOUTE CES 2 LIGNES ICI
  processingToken  String?   // sert à bloquer les doubles facturations
  lastProcessedAt  DateTime? // utilisé pour le throttle anti-spam

  @@unique([shop, periodKey])
}

